generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  HQ_ADMIN
  PROVINCIAL_ADMIN
  STATION_USER
  DEVICE_CLIENT
}

enum VehicleStatus {
  ACTIVE
  INACTIVE
  MAINTENANCE
}

model Province {
  id        String     @id @default(cuid())
  name      String
  code      String     @unique
  districts District[]
  users     User[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model District {
  id        String         @id @default(cuid())
  name      String
  code      String         @unique
  provinceId String
  province  Province       @relation(fields: [provinceId], references: [id], onDelete: Cascade)
  stations  PoliceStation[]
  vehicles  Vehicle[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@index([provinceId])
}

model PoliceStation {
  id         String   @id @default(cuid())
  name       String
  code       String   @unique
  districtId String
  district   District @relation(fields: [districtId], references: [id], onDelete: Cascade)
  lat        Float
  lng        Float
  users      User[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([districtId])
}

model Vehicle {
  id                String        @id @default(cuid())
  regNumber         String        @unique
  deviceId          String        @unique
  driverName        String?
  status            VehicleStatus @default(ACTIVE)
  currentDistrictId String?
  currentDistrict   District?     @relation(fields: [currentDistrictId], references: [id], onDelete: SetNull)
  pings             LocationPing[]
  users             User[]
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([status])
  @@index([currentDistrictId])
}

model LocationPing {
  id         String   @id @default(cuid())
  vehicleId  String
  vehicle    Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  lat        Float
  lng        Float
  speed      Float?
  heading    Float?
  timestamp  DateTime
  recordedAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([vehicleId, timestamp(sort: Desc)])
}

model User {
  id           String        @id @default(cuid())
  name         String
  email        String        @unique
  passwordHash String
  role         Role
  stationId    String?
  station      PoliceStation? @relation(fields: [stationId], references: [id], onDelete: SetNull)
  provinceId   String?
  province     Province?     @relation(fields: [provinceId], references: [id], onDelete: SetNull)
  vehicleId    String?
  vehicle      Vehicle?      @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([role])
}
