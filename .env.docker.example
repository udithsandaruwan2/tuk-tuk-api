PORT=8000
NODE_ENV=production
JWT_SECRET=replace-with-strong-secret
JWT_EXPIRES_IN=1h

# Production behind Traefik + Cloudflare — use your public API origin.
ALLOWED_ORIGINS=https://api.udithsandaruwan.com

# Required when Traefik terminates TLS (Express sees X-Forwarded-Proto: https).
TRUST_PROXY=true
PUBLIC_BASE_URL=https://api.udithsandaruwan.com

# Neon / Postgres
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# Traefik / Let's Encrypt variables belong in project `.env` — see `compose.env.example`.
