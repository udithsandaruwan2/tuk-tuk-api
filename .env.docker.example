PORT=8000
NODE_ENV=production
JWT_SECRET=replace-with-strong-secret
JWT_EXPIRES_IN=1h
ALLOWED_ORIGINS=http://localhost:8000

# Use Neon Postgres URL (preferred for deployment)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# --- Traefik profile (`docker compose --profile traefik up`) ---
# Compose substitutes APP_DOMAIN / LETSENCRYPT_EMAIL from a file named `.env` in this directory
# (same folder as docker-compose.yml), NOT from this file alone. Either:
#   - Add APP_DOMAIN and LETSENCRYPT_EMAIL to `.env`, or
#   - Export them:  APP_DOMAIN=api.example.com LETSENCRYPT_EMAIL=you@example.com docker compose --profile traefik up
# If APP_DOMAIN is unset, labels default to api.localhost (for a non-empty Traefik rule only).
APP_DOMAIN=api.example.com
LETSENCRYPT_EMAIL=you@example.com
