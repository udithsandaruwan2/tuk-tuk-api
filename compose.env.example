# Copy to `.env` next to `docker-compose.yml` (Compose reads this for Traefik labels + ACME).
# cp compose.env.example .env
#
# Production API host (Traefik Host rule + Let's Encrypt certificate name)
APP_DOMAIN=api.udithsandaruwan.com

# Let's Encrypt account email (required for ACME)
LETSENCRYPT_EMAIL=you@udithsandaruwan.com
